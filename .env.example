# MindPalace runtime config — copy to .env and tweak as needed.

# Where the SQLite DB and backups live. Default: ./data/
# MINDPALACE_DATA_DIR=/Users/me/.mindpalace

# Override the DB path explicitly. Default: $MINDPALACE_DATA_DIR/mindpalace.db
# MINDPALACE_DB_PATH=/Users/me/.mindpalace/mindpalace.db

# Embedding model used by the optional semantic-search extra.
# Default: BAAI/bge-small-en-v1.5
# MINDPALACE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Strip write tools from the MCP surface (read-only mode).
# Useful when granting another LLM context without write power.
# MINDPALACE_READONLY=1
